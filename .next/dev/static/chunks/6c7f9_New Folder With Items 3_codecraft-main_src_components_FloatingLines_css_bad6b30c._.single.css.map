.floating-lines-container {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.floating-lines-fallback {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(120% 80% at 80% 50%, rgba(82, 39, 255, 0.18) 0%, transparent 55%),
    radial-gradient(100% 60% at 10% 40%, rgba(100, 30, 120, 0.12) 0%, transparent 50%),
    radial-gradient(80% 50% at 50% 90%, rgba(20, 30, 80, 0.25) 0%, transparent 60%),
    #000000;
}
